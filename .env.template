
# Enhanced Agentic RAG Assistant Environment Variables
# Copy this file to .env and fill in your API keys

# Required: AI API Configuration
# Primary option: Use Abacus AI API (recommended)
ABACUSAI_API_KEY=your_abacus_ai_api_key_here

# Alternative: OpenAI API (if not using Abacus AI)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Langchain Configuration (for advanced tracing)
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=enhanced-agentic-rag-app

# Search Tool Configuration (Optional - enhances web search capabilities)
# SerpAPI for premium search features
SERPAPI_API_KEY=your_serpapi_key_here
# Google Custom Search (alternative)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# MySQL Database Configuration (Optional - for database operations)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=your_database_name

# MongoDB Database Configuration (Optional - for NoSQL operations)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DATABASE=agentic_rag
MONGODB_AUTH_SOURCE=admin

# Multi-Agent System Configuration
ENABLE_CALCULATOR=true
ENABLE_SEARCH=true
ENABLE_DATABASE=true
ENABLE_RAG=true
COORDINATION_STRATEGY=auto
MAX_AGENTS_PER_QUERY=4

# Advanced Configuration (Optional)
VECTOR_DB_PATH=./vector_store
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE=209715200
